{
  "name": "ng-time-past-pipe",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lib": "ng build NgTimePastPipe --watch",
    "build": "npm run build:playground",
    "test": "ng test",
    "lint": "ng lint",
    "build:lib": "ng build NgTimePastPipe --configuration production",
    "test:lib": "ng test NgTimePastPipe",
    "test:lib:headless": "cross-env CI=true npm run test:lib",
    "copy:assets": "(xcopy README.md dist\\ng-time-past-pipe /y && xcopy CHANGELOG.md dist\\ng-time-past-pipe /y && xcopy LICENSE dist\\ng-time-past-pipe /y) || cp -r README.md CHANGELOG.md LICENSE dist/ng-time-past-pipe",
    "release": "cd projects/ng-time-past-pipe && standard-version --infile ../../CHANGELOG.md",
    "publish": "npm run build:lib && npm run copy:assets && cd dist/ng-time-past-pipe && npm publish",
    "build:playground": "npm run build:lib && ng build --configuration production"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^20.3.14",
    "@angular/compiler": "^20.3.4",
    "@angular/core": "^20.3.4",
    "@angular/platform-browser": "^20.3.4",
    "@angular/platform-browser-dynamic": "^20.3.4",
    "rxjs": "~7.5.2",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.4",
    "@angular/language-service": "^20.3.4",
    "@types/jasmine": "~3.10.2",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "20.19",
    "cross-env": "^7.0.3",
    "jasmine-core": "^4.2.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^20.3.0",
    "protractor": "~7.0.0",
    "standard-version": "^9.5.0",
    "ts-node": "~10.8.1",
    "tslint": "~6.1.3",
    "typescript": "~5.8.3"
  }
}
